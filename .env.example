# =============================================================================
# ERP.TWOINONEORDER — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets.
#
# Variables prefixed VITE_ are exposed to the browser bundle.
# Variables WITHOUT the VITE_ prefix are server-side only (Vercel serverless
# functions) and must never be referenced from client-side code.
# =============================================================================

# --- Supabase (public/browser-safe) -----------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (server-side only — Vercel functions / edge functions) --------
# Bypasses Row Level Security. Never expose to the browser. Never prefix
# with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (server-side only) ------------------------------------------
# Google Gemini — used by the api/scan-* functions for invoice, quotation and
# labour-list extraction. Get a key at https://aistudio.google.com/apikey.
# Never expose to the browser. Never prefix with VITE_.
GEMINI_API_KEY=
# Optional; defaults to gemini-2.5-flash.
GEMINI_MODEL=

# --- App configuration --------------------------------------------------------
VITE_APP_NAME=ERP.TWOINONEORDER
VITE_APP_ENV=development
